  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>成都文旅 - 天府之国，烟火成都</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#ff7828', // 主色：暖橙，火锅烟火
            secondary: '#38a384', // 辅助色：青绿，熊猫绿植
          },
          fontFamily: {
