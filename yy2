          </div>
        </div>
        <!-- 景点卡片2 -->
        <div class="bg-white rounded-lg overflow-hidden shadow card-hover">
          <img src="https://picsum.photos/id/1036/600/400" alt="宽窄巷子" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-bold text-lg mb-2">宽窄巷子</h4>
            <p class="text-gray-600 text-sm">老成都民居街巷，喝茶打卡好去处。</p>
          </div>
        </div>
        <!-- 景点卡片3 -->
        <div class="bg-white rounded-lg overflow-hidden shadow card-hover">
          <img src="https://picsum.photos/id/1039/600/400" alt="锦里古街" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-bold text-lg mb-2">锦里古街</h4>
            <p class="text-gray-600 text-sm">三国风情古街，夜景非常出片。</p>
          </div>
        </div>
        <!-- 景点卡片4 -->
        <div class="bg-white rounded-lg overflow-hidden shadow card-hover">
          <img src="https://picsum.photos/id/1018/600/400" alt="都江堰" class="w-full h-48 object-cover">
          <div class="p-4">
