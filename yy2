          </div>
        </div>
      </div>
      <!-- 轮播按钮 -->
      <button id="prevBtn" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/60 hover:bg-white w-10 h-10 rounded-full text-xl">‹</button>
      <button id="nextBtn" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/60 hover:bg-white w-10 h-10 rounded-full text-xl">›</button>
    </div>
  </section>

  <!-- 成都简介 -->
