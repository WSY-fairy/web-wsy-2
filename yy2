      </div>
    </div>
  </section>

  <!-- 成都美食 -->
  <section id="food" class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <h3 class="text-[clamp(1.5rem,3vw,2.2rem)] font-bold text-center mb-10">地道成都美食</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-gray-50 rounded-lg overflow-hidden shadow card-hover">
          <img src="https://picsum.photos/id/292/600/400" alt="火锅" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-bold text-lg mb-2">牛油火锅</h4>
            <p class="text-gray-600 text-sm">麻辣鲜香，成都灵魂。</p>
          </div>
        </div>
        <div class="bg-gray-50 rounded-lg overflow-hidden shadow card-hover">
          <img src="https://picsum.photos/id/291/600/400" alt="担担面" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-bold text-lg mb-2">担担面</h4>
            <p class="text-gray-600 text-sm">咸香微辣，经典川味小吃。</p>
          </div>
        </div>
        <div class="bg-gray-50 rounded-lg overflow-hidden shadow card-hover">
          <img src="https://picsum.photos/id/290/600/400" alt="钟水饺" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-bold text-lg mb-2">钟水饺</h4>
            <p class="text-gray-600 text-sm">红油甜香，皮薄馅嫩。</p>
          </div>
        </div>
        <div class="bg-gray-50 rounded-lg overflow-hidden shadow card-hover">
          <img src="https://picsum.photos/id/289/600/400" alt="串串香" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-bold text-lg mb-2">串串香</h4>
            <p class="text-gray-600 text-sm">一把一串，自在随心。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 攻略资讯 -->
  <section id="strategy" class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <h3 class="text-[clamp(1.5rem,3vw,2.2rem)] font-bold text-center mb-10">旅游攻略</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="bg-white p-5 rounded-lg shadow card-hover">
          <h4 class="font-bold text-lg mb-2">成都3日轻松游玩路线</h4>
          <p class="text-gray-600 text-sm">不走回头路，打卡熊猫、古街、美食，适合第一次来成都的游客。</p>
        </article>
        <article class="bg-white p-5 rounded-lg shadow card-hover">
          <h4 class="font-bold text-lg mb-2">成都美食避坑指南</h4>
          <p class="text-gray-600 text-sm">本地人常去的老店，拒绝网红溢价，吃到正宗川味。</p>
        </article>
        <article class="bg-white p-5 rounded-lg shadow card-hover">
          <h4 class="font-bold text-lg mb-2">都江堰一日游攻略</h4>
          <p class="text-gray-600 text-sm">交通、门票、游览顺序，轻松玩转水利古城。</p>
        </article>
      </div>
    </div>
