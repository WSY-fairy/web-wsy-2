      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- 景点卡片1 -->
        <div class="bg-white rounded-lg overflow-hidden shadow card-hover">
          <img src="https://picsum.photos/id/40/600/400" alt="大熊猫繁育研究基地" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-bold text-lg mb-2">大熊猫繁育研究基地</h4>
